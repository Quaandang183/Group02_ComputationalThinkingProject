# TripWise Environment Configuration Example
# Sao chép file này thành .env hoặc .env.local để tùy chỉnh môi trường chạy

# Địa chỉ máy chủ Backend API (RESTful / GraphQL)
VITE_API_BASE_URL=https://api.tripwise.local/v1

# Chế độ môi trường (development | staging | production)
VITE_APP_ENV=development

# Kích hoạt dữ liệu giả định dự phòng an toàn khi backend chưa chạy
VITE_ENABLE_MOCK=true

# Tên ứng dụng hiển thị
VITE_APP_TITLE=TripWise
