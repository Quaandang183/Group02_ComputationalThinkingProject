# ==============================================================================
# TRIPWISE BACKEND - ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# Copy this file to '.env' and fill in your actual values.
# ==============================================================================

# 1. Database URL (PostgreSQL / Supabase or local SQLite)
# Supabase example: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
# SQLite test example: sqlite:///./tripwise_dalat.db
DATABASE_URL=postgresql://postgres:your_password@db.onulhxzfoyorgktajalt.supabase.co:5432/postgres

# 2. Supabase API Credentials
SUPABASE_URL=https://onulhxzfoyorgktajalt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 3. AI & External APIs
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here

# 4. Auth & Security (JWT Token & Bcrypt)
# Command to generate a secure random secret key: openssl rand -hex 32
JWT_SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 5. Mobile Deep Link & CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,tripwise://*
